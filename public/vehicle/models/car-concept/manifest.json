{
  "$comment": "One manifest per car. The viewer reads only this file, never the raw names in the GLB. To swap in the Jesko: run scripts/build-model.mjs on its file, write a manifest like this one beside it, and point data-vehicle-model on the hero stage at it. The story (src/story) reads camera.shots by name: a shot is an azimuth and polar angle in degrees, a zoom (a multiple of the distance that fits the car; larger is farther) and an optional look-at target as fractions of the car’s box (x and z from its centre, y from the ground), with \"compact\" overrides for phone-sized screens.",
  "id": "car-concept",
  "name": "Car Concept (temporary stand-in)",
  "standIn": true,
  "credit": {
    "title": "Car Concept",
    "source": "Khronos glTF Sample Assets",
    "url": "https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/CarConcept",
    "copyright": "© 2024 Darmstadt Graphics Group GmbH",
    "author": "Eric Chadwick (model and textures)",
    "license": "CC BY 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by/4.0/legalcode",
    "basedOn": "Public-domain (CC0) model by Unity Fan: https://sketchfab.com/3d-models/free-concept-car-004-public-domain-cc0-4cba124633eb494eadc3bb0c4660ad7e",
    "trademarks": "The Khronos logo (2015) and 3D Commerce logo (2017) in the textures are Khronos Group trademarks, not covered by the CC licence; the viewer hides them."
  },
  "src": {
    "desktop": "/vehicle/models/car-concept/model-desktop.f537c06b.glb",
    "mobile": "/vehicle/models/car-concept/model-mobile.99bebe7d.glb"
  },
  "build": {
    "simplify": {
      "match": "Wipers|^Wheel(Front|Rear)[LR](BrakePad)?$",
      "error": 0.003
    }
  },
  "orientation": {
    "forward": "+z"
  },
  "hide": [
    "License Plate",
    "InteriorSteeringEmblem"
  ],
  "materials": {
    "paint": {
      "match": "^Paint 1",
      "set": {
        "clearcoat": 1,
        "iridescence": 0
      }
    },
    "paintAccent": {
      "match": "^Paint 2",
      "set": {
        "color": "#0d1014",
        "metalness": 0.35,
        "roughness": 0.42,
        "clearcoat": 0.6,
        "clearcoatRoughness": 0.2,
        "iridescence": 0
      }
    },
    "interior": {
      "match": "^Interior 3",
      "set": {
        "color": "#22262c"
      }
    },
    "glass": {
      "match": "^Glass$",
      "set": {
        "color": "#0a0f15",
        "metalness": 0,
        "roughness": 0.04,
        "transmission": 0,
        "transparent": true,
        "opacity": 0.42
      }
    },
    "tyreSidewall": {
      "match": "^Tireside$",
      "set": {
        "map": null,
        "normalMap": null,
        "color": "#1e1e1e"
      }
    }
  },
  "variants": {
    "$comment": "Paint variants for Chapter V (src/story/chapters/yours.js), applied to the material materials.paint matches; the default is the car's paint everywhere else and in every poster. Our own descriptive names, not factory colours. A variant may set only color, metalness, roughness and clearcoatRoughness (scripts/build-model.mjs checks it), so a change never recompiles a shader.",
    "paint": [
      {
        "id": "midnight",
        "label": "Midnight",
        "default": true,
        "set": {
          "color": "#18213a",
          "metalness": 0.55,
          "roughness": 0.34,
          "clearcoatRoughness": 0.06
        }
      },
      {
        "id": "graphite",
        "label": "Graphite",
        "set": {
          "color": "#2a2d31",
          "metalness": 0.6,
          "roughness": 0.3,
          "clearcoatRoughness": 0.08
        }
      },
      {
        "id": "ice",
        "label": "Ice",
        "set": {
          "color": "#b9c6cf",
          "metalness": 0.5,
          "roughness": 0.26,
          "clearcoatRoughness": 0.05
        }
      },
      {
        "id": "bone",
        "label": "Bone",
        "set": {
          "color": "#cfc6b4",
          "metalness": 0.12,
          "roughness": 0.42,
          "clearcoatRoughness": 0.08
        }
      },
      {
        "id": "ember",
        "label": "Ember",
        "set": {
          "color": "#b3400f",
          "metalness": 0.35,
          "roughness": 0.3,
          "clearcoatRoughness": 0.05
        }
      }
    ]
  },
  "parts": {
    "wheels": [
      "WheelFrontL",
      "WheelFrontR",
      "WheelRearL",
      "WheelRearR"
    ],
    "rims": [
      "WheelFrontLRim",
      "WheelFrontRRim",
      "WheelRearLRim",
      "WheelRearRRim"
    ],
    "doors": [
      "BodyDoorLColor1",
      "BodyDoorRColor1"
    ]
  },
  "camera": {
    "fov": 26,
    "fill": 1.22,
    "offsetY": -0.05,
    "offsetYCompact": 0.03,
    "targetHeight": 0.4,
    "home": {
      "azimuth": -38,
      "polar": 74
    },
    "views": {
      "front": {
        "azimuth": 0,
        "polar": 80
      },
      "side": {
        "azimuth": -90,
        "polar": 82
      },
      "rear": {
        "azimuth": 180,
        "polar": 76
      }
    },
    "limits": {
      "polarMin": 58,
      "polarMax": 86,
      "zoomMin": 0.8,
      "zoomMax": 1.6
    },
    "shots": {
      "power": {
        "azimuth": 150,
        "polar": 84,
        "zoom": 1.5,
        "target": [
          0,
          0.4,
          -0.08
        ],
        "compact": {
          "zoom": 1.15
        }
      },
      "yours": {
        "azimuth": -55,
        "polar": 84,
        "zoom": 1.0
      }
    }
  },
  "posters": {
    "$comment": "Still images rendered from this model by scripts/render-posters.mjs (npm run posters; vite build re-renders when they are out of date). Shots as in camera.shots; hero is cut out to the car, detail is framed edge to edge.",
    "hero": {
      "shot": {
        "azimuth": -38,
        "polar": 74,
        "zoom": 1.4
      },
      "size": [
        2400,
        1354
      ],
      "widths": [
        960,
        1600,
        2400
      ]
    },
    "detail": {
      "shot": {
        "azimuth": -40,
        "polar": 80,
        "zoom": 0.4,
        "target": [
          -0.3,
          0.46,
          0.32
        ]
      },
      "size": [
        1400,
        934
      ],
      "widths": [
        800,
        1400
      ]
    }
  }
}
